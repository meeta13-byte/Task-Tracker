<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_dark_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Task Tracker Setup"
            android:textColor="@color/github_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Connect your Google Sheet Web App to power your Samsung home screen widget."
            android:textColor="@color/github_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google Apps Script Web App URL:"
            android:textColor="@color/github_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_script_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/widget_bg"
            android:hint="https://script.google.com/macros/s/.../exec"
            android:padding="12dp"
            android:textColor="@color/github_white"
            android:textColorHint="#484f58"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/github_streak"
            android:text="Save &amp; Sync Widget"
            android:textColor="@color/github_white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text=""
            android:textColor="@color/github_text"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
